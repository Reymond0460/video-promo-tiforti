{
  "name": "video-promo-tiforti",
  "version": "1.0.0",
  "private": true,
  "description": "Video publicitario de TiforTi (tiforti.cl) hecho con Remotion",
  "scripts": {
    "studio": "remotion studio",
    "render": "bash scripts/render-todo.sh",
    "render:vertical": "bash scripts/render-todo.sh PromoVertical",
    "render:horizontal": "bash scripts/render-todo.sh PromoHorizontal",
    "render:corto": "bash scripts/render-todo.sh PromoCorto30",
    "audio": "python3 scripts/generar-musica.py && python3 scripts/generar-sfx.py",
    "voz": "python3 scripts/generar-voz.py",
    "subtitulos": "node scripts/generar-subtitulos.mjs",
    "capturas": "node scripts/capturar-sitio.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.542",
    "@remotion/cli": "4.0.542",
    "@remotion/renderer": "4.0.542",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.542"
  },
  "devDependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "typescript": "^7.0.2"
  }
}
